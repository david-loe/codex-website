# Alle Verbindungswerte ausdrücklich setzen; keine Standardwerte.
# ssh | ftp | ftps
DEPLOY_PROTOCOL=
# Hostname oder IPv4-Adresse, ohne Protokoll oder Port
DEPLOY_HOST=
# Port des Anbieters (1–65535)
DEPLOY_PORT=
DEPLOY_USER=
# Konkretes Webverzeichnis; wird vor dem Upload vollständig geleert.
# Kein Wurzelverzeichnis, keine .- oder ..-Segmente.
DEPLOY_PATH=

# Nur FTP/FTPS: erforderlich. Leerzeichen im Passwort mit Anführungszeichen erhalten.
DEPLOY_PASSWORD=
# Nur FTPS: explicit | implicit (erforderlich)
DEPLOY_FTPS_MODE=

# Nur SSH: key | agent (erforderlich)
DEPLOY_SSH_AUTH=
# Nur SSH mit key: privater Schlüsselpfad oder Dateiname unter ~/.ssh
DEPLOY_KEY=
