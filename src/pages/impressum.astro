---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Impressum"
  description="Impressum für den generischen Website Starter."
>
  <section class="mx-auto max-w-4xl px-5 py-16 prose-text">
    <h1 class="text-4xl font-semibold tracking-[0]">Impressum</h1>
    <p class="mt-6 text-[var(--muted)]">
      Dies ist ein Blindtext für spätere rechtliche Angaben und geprüfte Pflichtinformationen.
    </p>
    <h2 class="mt-10 text-2xl font-semibold">Verantwortliche Stelle</h2>
    <p class="text-[var(--muted)]">Dies ist ein Blindtext für Adresse, Kontakt und weitere Angaben.</p>
  </section>
</BaseLayout>
