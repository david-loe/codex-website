---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Website Starter"
  description="Eine statische Website-Vorlage für eine agentisch gestaltete Webpräsenz."
>
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-24">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.12em] text-[var(--accent)]">
          Statischer Website-Starter
        </p>
        <h1 class="max-w-3xl text-4xl font-semibold leading-tight tracking-[0] text-[var(--ink)] md:text-6xl">
          Website Starter
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-[var(--muted)]">
          Dies ist ein Blindtext für die spätere Ausarbeitung. Er markiert Raum
          für Inhalt, Tonalität und klare Botschaften ohne finale Aussagen.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-md bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-white hover:bg-[var(--accent-dark)]" href="/services/">
            Leistungen ansehen
          </a>
          <a class="rounded-md border border-[var(--line)] px-5 py-3 text-sm font-semibold text-[var(--ink)] hover:border-[var(--accent)] hover:text-[var(--accent)]" href="/contact/">
            Kontakt
          </a>
        </div>
      </div>
      <div class="rounded-lg border border-[var(--line)] bg-[var(--paper)] p-6">
        <h2 class="text-xl font-semibold text-[var(--ink)]">Für statisches Hosting vorbereitet</h2>
        <ul class="mt-5 space-y-3 text-[var(--muted)]">
          <li>Dies ist ein Blindtext mit Platz für technische Hinweise.</li>
          <li>Dies ist ein Blindtext für spätere Anforderungen.</li>
          <li>Dies ist ein Blindtext für den nächsten Ausbauschritt.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-6 md:grid-cols-3">
      <article class="rounded-lg border border-[var(--line)] bg-white p-6">
        <h2 class="text-xl font-semibold">Klare Struktur</h2>
        <p class="mt-3 text-[var(--muted)]">Dies ist ein Blindtext für spätere Inhalte, Abschnitte und redaktionelle Details.</p>
      </article>
      <article class="rounded-lg border border-[var(--line)] bg-white p-6">
        <h2 class="text-xl font-semibold">Responsive Gestaltung</h2>
        <p class="mt-3 text-[var(--muted)]">Dies ist ein Blindtext für Ansichten auf kleinen und großen Bildschirmen.</p>
      </article>
      <article class="rounded-lg border border-[var(--line)] bg-white p-6">
        <h2 class="text-xl font-semibold">Schlanker Aufbau</h2>
        <p class="mt-3 text-[var(--muted)]">Dies ist ein Blindtext für spätere technische Einordnung und Erweiterungen.</p>
      </article>
    </div>
  </section>
</BaseLayout>
