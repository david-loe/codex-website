---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Profil"
  description="Profilseite für den generischen Website Starter."
>
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <div class="max-w-3xl prose-text">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.12em] text-[var(--accent)]">Profil</p>
      <h1 class="text-4xl font-semibold leading-tight tracking-[0] md:text-5xl">Profil</h1>
      <p class="mt-6 text-lg text-[var(--muted)]">
        Dies ist ein Blindtext für eine spätere Vorstellung. Er dient als Platzhalter
        für Haltung, Hintergrund und eine klare redaktionelle Richtung.
      </p>
      <p class="mt-5 text-[var(--muted)]">
        Dies ist ein Blindtext für ergänzende Angaben, Schwerpunkte und Zielgruppen.
      </p>
    </div>
  </section>
</BaseLayout>
